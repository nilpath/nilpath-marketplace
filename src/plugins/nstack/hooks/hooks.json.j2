{% set script = '$CLAUDE_PLUGIN_ROOT/' ~ ('com.github.copilot/hooks' if harness == 'copilot' else 'hooks') ~ '/nstack_config.py' -%}
{% macro run_python(command) -%}
if command -v pyenv >/dev/null 2>&1; then pyenv exec python3 "{{ script }}" {{ command }}; else python3 "{{ script }}" {{ command }}; fi
{%- endmacro %}
{% set launch = run_python('hook') ~ ' || true' -%}
{% set session = run_python('session-start') ~ ' || true' -%}
{% set failure = run_python('post-tool-failure') -%}
{% if harness == "copilot" -%}
{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": {{ session | tojson }},
        "timeoutSec": 15
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "task",
        "bash": {{ launch | tojson }},
        "timeoutSec": 15
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": {{ failure | tojson }},
        "timeoutSec": 15
      }
    ]
  }
}
{% else -%}
{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ session | tojson }},
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "{{ 'Agent' if harness == 'claude' else 'spawn_agent' }}",
        "hooks": [
          {
            "type": "command",
            "command": {{ launch | tojson }},
            "timeout": 15
          }
        ]
      }
    ]
  }
}
{% endif -%}
