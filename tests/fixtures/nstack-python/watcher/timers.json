{
  "runtime": {
    "name": "Bun",
    "version": "1.3.6"
  },
  "timer": "node:timers/promises.setTimeout(seconds * 1000), as imported by the pinned original cli.ts",
  "watchdogMilliseconds": 100,
  "cases": [
    {
      "seconds": 0.0001,
      "requestedMilliseconds": 0.1,
      "clampedMilliseconds": 1,
      "outcome": "resolved",
      "expectedSleepSeconds": 0.001
    },
    {
      "seconds": 0.0009999,
      "requestedMilliseconds": 0.9999,
      "clampedMilliseconds": 1,
      "outcome": "resolved",
      "expectedSleepSeconds": 0.001
    },
    {
      "seconds": 0.0019,
      "requestedMilliseconds": 1.9,
      "clampedMilliseconds": 1,
      "outcome": "resolved",
      "expectedSleepSeconds": 0.001
    },
    {
      "seconds": 1.2349,
      "requestedMilliseconds": 1234.9,
      "clampedMilliseconds": 1234,
      "outcome": "bounded-watchdog",
      "expectedSleepSeconds": 1.234
    },
    {
      "seconds": 2147483.648,
      "requestedMilliseconds": 2147483648,
      "clampedMilliseconds": 1,
      "outcome": "resolved",
      "expectedSleepSeconds": 0.001
    },
    {
      "seconds": 2500000,
      "requestedMilliseconds": 2500000000,
      "clampedMilliseconds": 1,
      "outcome": "resolved",
      "expectedSleepSeconds": 0.001
    },
    {
      "seconds": 1e+308,
      "requestedMilliseconds": "Infinity",
      "clampedMilliseconds": 1,
      "outcome": "resolved",
      "expectedSleepSeconds": 0.001
    }
  ]
}
